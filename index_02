* {

    box-sizing: border-box;

}

html {

    scroll-behavior: smooth;

}

body {

    margin: 0;

    font-family: Arial, sans-serif;

    background-color: #f5f5f5;

    color: #333;

}

.about-section {

    padding: 40px 20px;

    max-width: 900px;

    margin: auto;

}

.about-section h2 {

    color: #493031;

    text-align: center;

    font-size: 28px;

}

.about-section p {

    font-size: 16px;

    line-height: 1.6;

}

.how-it-works {

    padding: 40px 20px;

    max-width: 900px;

    margin: auto;

}

.how-it-works h2 {

    text-align: center;

    color: #493031;

}

.how-steps {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 15px;

}

.how-step {

    background-color: white;

    padding: 20px;

    border: 1px solid #ddd;

    border-radius: 6px;

    text-align: center;

}

.step-number {

    font-weight: bold;

    color: #493031;

    margin-bottom: 10px;

}

.how-step h3 {

    font-size: 18px;

    margin-bottom: 10px;

}

.how-step p {

    font-size: 14px;

    line-height: 1.5;

}

@media (max-width: 700px) {

    .how-steps {

        grid-template-columns: 1fr;

    }

}
