html {
scroll-behavior: smooth;
}
.navbar {
 background-color: white;
}

.navbar-brand,

.nav-link {

    color: #493031;

    text-decoration: none;

}

h1, h2, h3 {

    color: #493031;

}

.hostel-card {

    background-color: white;

    border: 1px solid #ddd;

    border-radius: 6px;

    padding: 15px;

    margin-bottom: 20px;

}

.hostel-card:hover {

    box-shadow: 0 2px 5px #ccc;

}

.hostel-photo {

    width: 100%;

    border-radius: 5px;

}

.btn-primary,

.load-more-button {

    background-color: #493031;

    color: white;

    padding: 10px 15px;

    border: none;

    border-radius: 5px;

    cursor: pointer;

}

.btn-primary:hover,

.load-more-button:hover {

    opacity: 0.8;

}

.reveal-on-scroll {

    opacity: 1;

    transform: none; 

}

* {

    box-sizing: border-box;

}

html {

    scroll-behavior: smooth;

}

body {

    margin: 0;

    font-family: Arial, sans-serif;

    background-color: #f5f5f5;

    color: #333;

}

.about-section {

    padding: 40px 20px;

    max-width: 900px;

    margin: auto;

}

.about-section h2 {

    color: #493031;

    text-align: center;

    font-size: 28px;

}

.about-section p {

    font-size: 16px;

    line-height: 1.6;

}

.how-it-works {

    padding: 40px 20px;

    max-width: 900px;

    margin: auto;

}

.how-it-works h2 {

    text-align: center;

    color: #493031;

}

.how-steps {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 15px;

}

.how-step {

    background-color: white;

    padding: 20px;

    border: 1px solid #ddd;

    border-radius: 6px;

    text-align: center;

}

.step-number {

    font-weight: bold;

    color: #493031;

    margin-bottom: 10px;

}

.how-step h3 {

    font-size: 18px;

    margin-bottom: 10px;

}

.how-step p {

    font-size: 14px;

    line-height: 1.5;

}

@media (max-width: 700px) {

    .how-steps {

        grid-template-columns: 1fr;

    }

}
